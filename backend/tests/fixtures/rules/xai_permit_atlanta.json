      "content": [
        {
          "type": "output_text",
          "text": "{\n  \"permit_required\": \"yes\",\n  \"permits\": [\n    {\n      \"name\": \"Mechanical (HVAC) Permit\",\n      \"office\": \"Office of Buildings, Trades Division\",\n      \"fee_note\": null,\n      \"url\": \"https://www.atlantaga.gov/residents/city-hall/online-services/apply-for-a-technical-permit\",\n      \"quote\": \"Permits are required for all new construction as well as for specific alterations to existing homes, including structural, plumbing, mechanical, and electrical changes. A Mechanical permit is required when you: Install or change any part of a heating or cooling system...\"\n    },\n    {\n      \"name\": \"Electrical Permit\",\n      \"office\": \"Office of Buildings, Trades Division\",\n      \"fee_note\": null,\n      \"url\": \"https://www.atlantaga.gov/residents/city-hall/online-services/apply-for-a-technical-permit\",\n      \"quote\": \"Electrical permits (commercial and residential) ... can be submitted online. ... Permits are required for ... electrical changes.\"\n    }\n  ],\n  \"who_can_pull\": {\n    \"homeowner_allowed\": \"yes\",\n    \"licence\": \"Licensed Georgia Mechanical Contractor (or Conditioned Air Contractor) for HVAC; Licensed Electrical Contractor for electrical. Homeowner may pull with affidavit for own primary residence.\"\n  },\n  \"inspections\": [\n    \"Mechanical final\",\n    \"Electrical rough-in\",\n    \"Electrical final\"\n  ],\n  \"code_basis\": [\n    \"2024 International Mechanical Code (IMC) with Georgia Amendments\",\n    \"2024 International Residential Code (IRC) with Georgia Amendments\",\n    \"2023 National Electrical Code (NEC) with Georgia Amendments\"\n  ],\n  \"caveats\": [\n    \"Exemptions apply only to repair/replacement of existing condensers, furnaces, or grills/diffusers; new installation requires permit.\",\n    \"Refrigerant line set through wall and new outdoor unit on pad likely trigger mechanical permit.\",\n    \"New dedicated 240V circuit requires separate electrical permit.\",\n    \"No building/zoning permit indicated for this scope on single-family house; confirm no tree/land disturbance or historic district issues.\",\n    \"Online system for technical/trade permits; registration required. Current as of 2026 code update.\"\n  ],\n  \"summary\": \"This job requires a Mechanical/HVAC permit for the new ductless mini-split heat pump installation and an Electrical permit for the new dedicated circuit, both from Atlanta's Office of Buildings Trades Division; licensed contractors typically pull them but homeowners may with affidavit for their primary residence; followed by electrical and mechanical inspections.\"\n}",
