          "text": "{\n  \"permit_required\": \"yes\",\n  \"permits\": [\n    {\n      \"name\": \"Plumbing Permit\",\n      \"office\": \"DeKalb County Department of Planning & Sustainability\",\n      \"fee_note\": \"$10 per water heater (minimum permit fee applies)\",\n      \"url\": \"https://dekalbcountyga.gov/sites/default/files/2026-01/Plumbing%20Permit%20Application%20Fillable_0.pdf\",\n      \"quote\": \"Water heaters No. _____ X $10.00 = __________ ... Check One: ... Replacement\"\n    },\n    {\n      \"name\": \"Mechanical Permit (if gas-fired)\",\n      \"office\": \"DeKalb County Department of Planning & Sustainability\",\n      \"fee_note\": null,\n      \"url\": \"https://dekalbcountyga.gov/departments/planning-and-sustainability/permits-plan-review-and-inspections\",\n      \"quote\": \"Mechanical Permit * Must be submitted by a licensed mechanical contractor * Includes mechanical systems within a building or structure * Gas pressure tests must be applied for by the licensed contractor\"\n    }\n  ],\n  \"who_can_pull\": {\n    \"homeowner_allowed\": \"no\",\n    \"licence\": \"State of Georgia licensed plumbing contractor (and mechanical contractor if applicable)\"\n  },\n  \"inspections\": [\n    \"Water Heater\",\n    \"Gas Line (if gas-fired)\",\n    \"Plumbing Final\",\n    \"Mechanical Final (if applicable)\"\n  ],\n  \"code_basis\": [\n    \"2024 International Residential Code with Georgia Amendments\",\n    \"2024 International Plumbing Code with Georgia Amendments\",\n    \"2024 International Mechanical Code with Georgia Amendments\",\n    \"2024 International Fuel Gas Code with Georgia Amendments\"\n  ],\n  \"caveats\": [\n    \"Trade permits (plumbing/mechanical) must be pulled by licensed contractors; homeowners may only pull certain building permits with affidavit and restrictions.\",\n    \"Reusing existing gas line/vent or electric circuit may still require gas pressure test or verification.\",\n    \"No building permit typically required for this scope in single-family replacement.\",\n    \"Confirm jurisdiction is unincorporated DeKalb County.\",\n    \"Inspection card lists specific Water Heater inspection under plumbing.\"\n  ],\n  \"summary\": \"A plumbing permit (and mechanical permit if gas) is required for water heater replacement in unincorporated DeKalb County, GA; must be pulled by a licensed contractor; inspections include Water Heater, gas line if applicable, and finals.\"\n}",
