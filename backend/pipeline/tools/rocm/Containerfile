# Build image for hfbox HIP artefacts: Ubuntu 24.04 + Python 3.12 + ROCm 7.2.1 (the exact
# ROCm torch 2.14+rocm7.2 was built against: torch.version.rocm == '7.2.1', hip 7.2.53211).
# No GPU needed; everything targets gfx1201.  Build:  podman build -t airtools-rocm721 .
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg build-essential git cmake ninja-build pkg-config file rsync \
      python3 python3-venv python3-dev python3-pip zstd xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.2.1 noble main" \
         > /etc/apt/sources.list.d/rocm.list \
    && printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' > /etc/apt/preferences.d/rocm-pin-600
# Compiler + the headers/libs torch cpp_extension, gsplat and COLMAP (HIP_ENABLED) need.
RUN apt-get update && apt-get install -y --no-install-recommends \
      hipcc hip-dev rocm-llvm rocm-device-libs rocm-cmake rocminfo rocm-core \
      hiprand-dev rocrand-dev rocprim-dev hipcub-dev rocthrust-dev \
      hipblas-dev hipblas-common-dev hipsparse-dev hipsolver-dev hipblaslt-dev \
      rocblas-dev rocsparse-dev rocsolver-dev hipfft-dev rocfft-dev \
    && rm -rf /var/lib/apt/lists/*
# Relocate to the path hfbox will use, so any path baked into a build matches there.
RUN mkdir -p /workspace && cp -a "$(readlink -f /opt/rocm)" /workspace/rocm \
    && rm -rf /opt/rocm /opt/rocm-7.2.1 /etc/alternatives/rocm
ENV ROCM_PATH=/workspace/rocm HIP_PATH=/workspace/rocm PATH=/workspace/rocm/bin:$PATH \
    LD_LIBRARY_PATH=/workspace/rocm/lib CMAKE_PREFIX_PATH=/workspace/rocm

# ---- COLMAP 4.2 (HIP) and OpenMVS develop (CPU) build deps, from Ubuntu 24.04 ----
RUN apt-get update && apt-get install -y --no-install-recommends \
      libboost-program-options-dev libboost-graph-dev libboost-system-dev libboost-iostreams-dev \
      libboost-serialization-dev libeigen3-dev libopenimageio-dev openimageio-tools libmetis-dev \
      libgoogle-glog-dev libgflags-dev libsqlite3-dev libceres-dev libsuitesparse-dev \
      libcurl4-openssl-dev libssl-dev libopencv-dev libnanoflann-dev libtinyxml2-dev \
      libgmp-dev libmpfr-dev libpng-dev libjpeg-dev libtiff-dev zlib1g-dev patchelf \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /usr/include/opencv4
# OpenMVS develop's non-apt deps (versions = its vcpkg ports), in their own prefix so they
# cannot shadow COLMAP's FetchContent PoseLib.
ARG OMVS_DEPS=/opt/omvs-deps
# (codeload tarballs, not git clone: the PoseLib commit is no longer on any branch of the fork)
RUN set -e; b() { u=$1; r=$2; shift 2; mkdir -p /tmp/s \
        && curl -fsSL "https://codeload.github.com/$u/tar.gz/$r" | tar xz -C /tmp/s --strip-components=1 \
        && cmake -S /tmp/s -B /tmp/s/b -GNinja -DCMAKE_BUILD_TYPE=Release \
           -DCMAKE_INSTALL_PREFIX=$OMVS_DEPS -DCMAKE_PREFIX_PATH=$OMVS_DEPS -DBUILD_SHARED_LIBS=OFF \
           -DCMAKE_POSITION_INDEPENDENT_CODE=ON "$@" \
        && cmake --build /tmp/s/b -j3 && cmake --install /tmp/s/b && rm -rf /tmp/s; }; \
    b CGAL/cgal v6.0.1 -DCGAL_BUILD_TESTS=OFF; \
    b cdcseacave/TinyEXIF 1.1.0 -DBUILD_DEMO=OFF; \
    b cdcseacave/TinyNPY v1.1 -DBUILD_DEMO=OFF; \
    b ddiakopoulos/tinyply 3.0 -DSHARED_LIB=OFF; \
    b syoyo/tinygltf v2.9.6 -DTINYGLTF_HEADER_ONLY=ON -DTINYGLTF_INSTALL=ON \
      -DTINYGLTF_BUILD_LOADER_EXAMPLE=OFF; \
    curl -fsSL -o $OMVS_DEPS/include/BS_thread_pool.hpp \
      https://raw.githubusercontent.com/bshoshany/thread-pool/v5.0.0/include/BS_thread_pool.hpp; \
    b cdcseacave/halfmesh v0.4.0 -DHALFMESH_BUILD_TESTS=OFF -DHALFMESH_BUILD_TOOLS=OFF \
      -DHALFMESH_BUILD_PYTHON=OFF -DHALFMESH_BUILD_PERF=OFF -DHALFMESH_BUILD_CROSSCHECKS=OFF -DHALFMESH_BUILD_BENCH=OFF; \
    b cdcseacave/PoseLib ccdd2f62d7ee91b41a1dce4dfd619b688b6c247a -DMARCH_NATIVE=OFF \
      -DWITH_BENCHMARK=OFF -DBUILD_TESTS=OFF -DPYTHON_PACKAGE=OFF
