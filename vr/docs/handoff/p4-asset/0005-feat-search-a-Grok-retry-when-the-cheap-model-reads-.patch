+def _retry_role_ready(role: str, first: str) -> bool:
+    """assetgen: `role` resolves (its LLM_<ROLE> setting is on) to a provider with a key, other
+    than `first`'s provider:model."""
     try:
-        page_dims = await llm.extract(
-            "cheap",
-            [
