+        ("previous one", "previous", {}),
+        ("show me option 2", "option", {"index": 1}),
+        ("the third one", "option", {"index": 2}),
+    ],
+)
+def test_phrases(text, kind, extra):
+    assert replace.match(text) == {"kind": kind, **extra}
