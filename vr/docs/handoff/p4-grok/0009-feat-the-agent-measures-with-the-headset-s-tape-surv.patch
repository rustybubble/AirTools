+def test_slope_uncertainty_from_gravity_residual():
+    assert tape_survey.slope_uncertainty_mm(4.2, 0.0) == 2.0
+    assert tape_survey.slope_uncertainty_mm(4.2, 0.08) == pytest.approx(7.9, abs=0.05)
