From 71f84d946f346a88ec0ef6429d243968309b6686 Mon Sep 17 00:00:00 2001
From: Ravindra Lakkireddy <85186928+rlakki08@users.noreply.github.com>
Date: Sun, 27 Sep 2026 03:12:59 -0400
Subject: [PATCH 4/6] texture: a catalogue crop the product fills matches any
 face (listings that swap W and D); cut cache v2

The Insignia over-the-range microwave's listing has W and D swapped, so the photo (the product
filling the frame) didn't match W/H and the saliency model's pick (the black door alone) won. The
frame test now tries every face aspect of (W, H, D); image.cut.json version 2 remakes old cut-outs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 server/assets.py    | 12 ++++++++++--
 server/meshgen.py   |  6 +++---
 server/photo_cut.py | 30 +++++++++++++++++++++++-------
 server/warm.py      |  3 ++-
 4 files changed, 38 insertions(+), 13 deletions(-)

diff --git a/server/assets.py b/server/assets.py
index 76e3244..6648744 100644
--- a/server/assets.py
+++ b/server/assets.py
@@ -583,6 +583,10 @@ def _shell_defaults(plan) -> set[str]:
     }
 
 
+def _size(dims: Dims) -> tuple[float, float, float]:
+    return (dims.w, dims.h, dims.d)
+
+
 def finish_of(part: Part, colors: dict) -> str:
     """texture: the material cue ("metal" | "plastic" | "painted") from the listing, else the
     sampled body colour."""
@@ -599,7 +603,9 @@ def _texture_sync(part: Part, geometry, photo: Path, plan, face, tier: str | Non
     info: dict = {}
     c = None
     if settings.ASSET_PHOTO_CUT or settings.ASSET_SIDE_COLOR or tier == "scad":
-        c = photo_cut.cut(photo, meshgen.face_aspect(part.dims_mm, face, rotate))
+        c = photo_cut.cut(
+            photo, meshgen.face_aspect(part.dims_mm, face, rotate), size=_size(part.dims_mm)
+        )
     if tier == "scad" and settings.ASSET_SCAD_ORIENT and c is not None:
         geometry = geometry if isinstance(geometry, trimesh.Scene) else trimesh.Scene(geometry)
         ori = meshgen.orientation(geometry, c.texture(rectify=True) if face == "front" else None)
@@ -897,7 +903,9 @@ def _box(part: Part, photo: Path | None):
             face = meshgen.aspect_guess(part.dims_mm, photo)
             finish, info = None, {}
             if get_settings().ASSET_SIDE_COLOR:
-                c = photo_cut.cut(photo, meshgen.face_aspect(part.dims_mm, face))
+                c = photo_cut.cut(
+                    photo, meshgen.face_aspect(part.dims_mm, face), size=_size(part.dims_mm)
+                )
                 finish = finish_of(part, c.colors)
