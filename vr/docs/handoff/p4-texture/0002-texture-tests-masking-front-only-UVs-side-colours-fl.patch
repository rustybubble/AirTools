+    w, h, d = DW_DIMS.w, DW_DIMS.h, DW_DIMS.d
+
+    def build(exe, code, work, dims):
+        if code == "FLAT":
+            return [(trimesh.creation.box(bounds=[[-w / 2, 0, 0], [w / 2, h, d]]), "#B9BCC0")], None
+        body = trimesh.creation.box(bounds=[[-w / 2, 0, 0], [w / 2, h, d - 30]])
+        handle = trimesh.creation.box(bounds=[[-200, h - 150, d - 30], [200, h - 110, d]])
+        return [(body, "#B9BCC0"), (handle, "#8A8A8A")], None
+
+    monkeypatch.setattr(meshgen, "build_scad", build)
+    out = tmp_path / "p" / "scad.glb"
+    rec = await meshgen.grok_scad_run(_part(), _studio(tmp_path / "image.jpg"), out)
+    assert rec["ok"] and rec["relief_pass"] == "kept" and len(calls) == 2
+    assert "flat" in calls[1]["messages"][-1]["content"]
+    assert rec["front_relief"] > meshgen.RELIEF_MIN and not rec.get("turned")
